# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real credentials. See README.md "Watchlist Alerts" for how to get these.

# Active alert delivery: Telegram (posts into a Telegram group via a bot)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather_here
TELEGRAM_CHAT_ID=your_group_chat_id_here

# Optional / not currently used by default: WhatsApp delivery via Meta's
# WhatsApp Cloud API (whatsapp.py). Only needed if you switch watchlist.py
# back to importing send_whatsapp_message instead of send_telegram_message.
# META_WHATSAPP_TOKEN=your_meta_access_token_here
# META_PHONE_NUMBER_ID=your_phone_number_id_here
# META_RECIPIENT_NUMBER=91XXXXXXXXXX
